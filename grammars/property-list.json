{
  "name": "Property List (OpenStep)",
  "scopeName": "source.plist",
  "type": "tree-sitter",
  "parser": "tree-sitter-property-list",
  // Root-only: the conventional `plist` injection name belongs to the XML
  // form; file contents distinguish this OpenStep form during root selection.
  "firstLineRegex": ["^\\s*//.*(?:Property List|property list)\\b"],
  // A block comment ends at its first closing delimiter; it cannot absorb
  // subsequent comments into another backtracking partition.
  "contentRegex": "^\\s*(?://[^\\r\\n]*(?:\\r?\\n|$)\\s*|/\\*(?:[^*]|\\*(?!/))*\\*/\\s*)*[({]",
  "fileTypes": ["plist", "dict", "scriptSuite", "scriptTerminology", "savedSearch"],
  "comments": {
    "start": "// "
  },
  "treeSitter": {
    "parserSource": "github:Formkunft/tree-sitter-property-list#31ff8b0a6dda1b88c8f24b0bc376a0ae573607b2",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "property-list.wasm",
    "highlightsQuery": "property-list-highlights.scm"
  }
}

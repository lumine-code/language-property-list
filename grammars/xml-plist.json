{
  "name": "Property List (XML)",
  "scopeName": "text.xml.plist",
  "type": "tree-sitter",
  "parser": "tree-sitter-xml",
  "injectionNames": ["plist", "xml-plist"],
  "firstLineRegex": ["^\\s*<\\?xml[^>]*>\\s*<!DOCTYPE\\s+plist\\b"],
  "contentRegex": "^\\s*(?:<\\?xml[^>]*>\\s*)?(?:<!DOCTYPE\\s+plist[^>]*>\\s*)?<plist\\b",
  "fileTypes": ["plist", "dict", "scriptSuite", "scriptTerminology", "savedSearch", "wflow"],
  "comments": {
    "start": "<!-- ",
    "end": " -->"
  },
  "treeSitter": {
    "parserSource": "github:tree-sitter-grammars/tree-sitter-xml/xml#5000ae8f22d11fbe93939b05c1e37cf21117162d",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "xml.wasm",
    "highlightsQuery": "xml-plist-highlights.scm",
    "foldsQuery": "xml-plist-folds.scm",
    "languageSegment": "xml",
    "tagsQuery": "xml-plist-tags.scm"
  }
}

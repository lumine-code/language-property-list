	<key>Checksum</key>
	<data>
	SGVsbG8sIHdvcmxkIQ==
	</data>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin</string>
		<key>LANG</key>
		<string>en_GB.UTF-8</string>
	</dict>
</dict>
</plist>
